---
import Button from "../components/button.astro";
import Separator from "../components/home/separator.astro";
import parcours from "../collections/parcours.json";
import Layout from "../layouts/main.astro";

const base = import.meta.env.BASE_URL;
const cvUrl = `${base}cv.html`;

const langues = [
	{ nom: "Français", niveau: "Langue maternelle" },
	{ nom: "Anglais", niveau: "Niveau scolaire" },
	{ nom: "Allemand", niveau: "Niveau scolaire" },
];

const interets = ["Lecture", "Dessin", "Jeux vidéo"];
---

<Layout title="Maloe Decastel — CV">
  <div
    class="relative z-20 w-full max-w-4xl mx-auto mt-16 px-7 md:mt-24 lg:mt-32 xl:px-0"
  >
    <div class="flex flex-col items-center md:flex-row">
      <div class="relative w-full md:w-1/2">
        <p
          class="mb-4 inline-flex items-center gap-2 rounded-full border border-accent/30 bg-accent-soft px-3 py-1 text-[0.7rem] font-semibold uppercase tracking-[0.15em] text-accent dark:border-accent/30 dark:bg-accent-night dark:text-accent-light"
        >
          <span class="h-1.5 w-1.5 rounded-full bg-accent dark:bg-accent-light"></span>
          Recherche de stage en programmation
        </p>
        <h1
          class="mb-5 text-4xl font-bold leading-tight md:text-4xl lg:text-6xl dark:text-white"
        >
          Bonjour, je m'appelle <span class="text-accent dark:text-accent-light">Maloe.</span>
        </h1>
        <p class="mb-6 text-base text-neutral-600 dark:text-neutral-400">
          Je suis élève en 10H G au CO de la Veveyse, à Châtel-St-Denis en
          Suisse, et je cherche un stage en programmation. <br
            class="hidden lg:block"
          />Vous trouverez ici mon parcours scolaire et mon CV à télécharger.
        </p>
        <p class="mb-2 font-semibold text-neutral-800 dark:text-neutral-200">
          Me contacter
        </p>
        <ul
          class="py-2 space-y-[3px] text-sm list-disc list-inside text-neutral-500 dark:text-neutral-400"
        >
          <li>
            <a class="hover:text-accent dark:hover:text-accent-light" href="tel:+41766178337"
              >+41 76 617 83 37</a
            >
          </li>
          <li>
            <a
              class="hover:text-accent dark:hover:text-accent-light"
              href="mailto:maloe.decastel@gmail.com">maloe.decastel@gmail.com</a
            >
          </li>
          <li>Châtel-St-Denis, Suisse</li>
        </ul>
        <div class="flex flex-wrap items-center gap-3">
          <Button text="Voir mon CV" link={cvUrl} />
          <Button text="M'écrire" link="mailto:maloe.decastel@gmail.com" />
        </div>
      </div>
      <div
        class="relative justify-end hidden w-full mt-10 md:flex md:pl-10 md:w-1/2 md:mt-0 md:translate-y-4 xl:translate-y-0"
      >
        <div class="relative z-50 w-full">
          <div
            class="absolute bottom-0 z-40 w-16 h-16 -translate-x-6 -translate-y-1/2 lg:top-auto top-0 lg:-translate-y-[330px] rounded-full"
          >
            <span
              class="relative z-20 flex items-center justify-center w-full h-full text-2xl border-8 border-white rounded-full dark:border-neutral-950 bg-neutral-100 dark:bg-neutral-900"
            >
              <span
                class="flex items-center justify-center w-full h-full bg-white border border-dashed rounded-full dark:bg-neutral-950 border-neutral-300 dark:border-neutral-700"
                >🎓</span
              >
            </span>
          </div>
          <div class="relative z-30 px-10">
            <img
              src={`${base}assets/images/portrait.svg`}
              alt="Maloe Decastel"
              loading="eager"
              decoding="auto"
              class="relative z-30 w-full aspect-[790/1189] md:max-w-md mx-auto dark:-translate-y-0.5"
            />
          </div>
          <div
            class="absolute bottom-0 right-0 z-20 w-full h-full lg:h-[420px] translate-x-0 -translate-y-px border border-dashed rounded-2xl bg-gradient-to-r dark:from-neutral-950 dark:via-black dark:to-neutral-950 from-white via-neutral-50 to-white border-neutral-300 dark:border-neutral-700"
          >
          </div>
        </div>
      </div>
    </div>
  </div>

  <Separator text="Mon parcours scolaire" />

  <section class="max-w-4xl mx-auto px-7 lg:px-0">
    <h2
      class="text-2xl font-bold leading-10 tracking-tight text-neutral-900 dark:text-neutral-100"
    >
      De l'école primaire au cycle d'orientation
    </h2>
    <p class="mb-8 text-base text-neutral-600 dark:text-neutral-400">
      Mon parcours dans le canton de Fribourg, du plus récent au plus ancien.
    </p>

    <ol
      class="relative ml-1.5 space-y-8 border-l border-dashed border-neutral-300 pl-7 dark:border-neutral-700"
    >
      {
        parcours.map((etape) => (
          <li class="relative">
            <span class="absolute -left-[35px] top-2 h-3 w-3 rounded-full bg-accent ring-4 ring-white dark:bg-accent-light dark:ring-neutral-950" />
            <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
              <h3 class="text-base font-semibold text-neutral-900 dark:text-neutral-100">
                {etape.etablissement}
              </h3>
              <span class="text-xs uppercase tracking-widest text-accent dark:text-accent-light">
                {etape.dates}
              </span>
            </div>
            <p class="text-sm text-neutral-500 dark:text-neutral-400">
              {etape.niveau} · {etape.cycle}
            </p>
          </li>
        ))
      }
    </ol>

    <div class="flex items-center justify-start w-full py-8">
      <Button text="Tout voir en détail" link={`${base}a-propos`} />
    </div>
  </section>

  <Separator text="Langues et centres d'intérêt" />

  <section class="max-w-4xl mx-auto px-7 lg:px-0">
    <div class="grid gap-12 sm:grid-cols-2">
      <div>
        <h2
          class="mb-4 text-2xl font-bold leading-10 tracking-tight text-neutral-900 dark:text-neutral-100"
        >
          Langues
        </h2>
        <ul class="divide-y divide-neutral-200 dark:divide-neutral-800">
          {
            langues.map((langue) => (
              <li class="flex items-baseline justify-between gap-4 py-3">
                <span class="text-base font-medium text-neutral-900 dark:text-neutral-100">
                  {langue.nom}
                </span>
                <span class="text-sm text-neutral-500 dark:text-neutral-400">
                  {langue.niveau}
                </span>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2
          class="mb-4 text-2xl font-bold leading-10 tracking-tight text-neutral-900 dark:text-neutral-100"
        >
          Centres d'intérêt
        </h2>
        <div class="flex flex-wrap gap-2">
          {
            interets.map((interet) => (
              <span class="rounded-full border border-accent/25 bg-accent-soft px-3 py-1.5 text-sm text-accent dark:border-accent/30 dark:bg-accent-night dark:text-accent-light">
                {interet}
              </span>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="max-w-4xl mx-auto mt-24 px-7 lg:px-0">
    <div
      class="rounded-2xl border border-dashed border-accent/30 bg-accent-soft/60 p-8 dark:border-accent/30 dark:bg-accent-night"
    >
      <h2
        class="text-2xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100"
      >
        Une question ?
      </h2>
      <p class="mt-2 text-base text-neutral-600 dark:text-neutral-400">
        Le plus simple reste l'e-mail. Vous pouvez aussi télécharger la version
        imprimable de mon CV pour l'envoyer ou l'imprimer.
      </p>
      <div class="flex flex-wrap items-center gap-3">
        <Button text="Envoyer un e-mail" link="mailto:maloe.decastel@gmail.com" />
        <Button text="CV imprimable (PDF)" link={cvUrl} />
      </div>
    </div>
  </section>
</Layout>
