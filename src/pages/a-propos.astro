---
import Button from "../components/button.astro";
import PageHeading from "../components/page-heading.astro";
import parcours from "../collections/parcours.json";
import Layout from "../layouts/main.astro";

const base = import.meta.env.BASE_URL;

const langues = [
	{ nom: "Français", niveau: "Langue maternelle" },
	{ nom: "Anglais", niveau: "Niveau scolaire" },
	{ nom: "Allemand", niveau: "Niveau scolaire" },
];

const secondaire = parcours.filter((etape) => etape.niveau === "École secondaire");
const primaire = parcours.filter((etape) => etape.niveau === "École primaire");
---

<Layout
  title="À propos — Maloe Decastel"
  description="Parcours scolaire, langues et centres d'intérêt de Maloe Decastel, élève au CO de la Veveyse."
>
  <section class="relative z-20 max-w-2xl mx-auto my-12 px-7 lg:px-0">
    <PageHeading
      title="À propos"
      description="Bonjour 👋 je m'appelle Maloe Decastel. J'habite à Châtel-St-Denis, en Suisse, et je suis actuellement en 10H G au CO de la Veveyse. Je cherche un stage en programmation."
    />

    <p
      class="mt-8 text-sm leading-6 text-gray-600 dark:text-neutral-400 sm:leading-7 lg:leading-8 sm:text-base lg:text-lg"
    >
      J'ai beaucoup changé d'école, ce qui m'a rendue assez sociable. Je suis
      sérieuse et motivée, j'aime apprendre en pratiquant et cela ne me dérange
      pas de travailler en équipe. Lorsqu'on me fait des remarques, je les prends
      en compte pour m'améliorer, et je n'ai pas peur de poser des questions. Je
      suis toujours impliquée et concentrée dans mon travail.
    </p>

    <p
      class="mt-4 text-sm leading-6 text-gray-600 dark:text-neutral-400 sm:leading-7 lg:leading-8 sm:text-base lg:text-lg"
    >
      En dehors de l'école, j'aime lire, dessiner et jouer aux jeux vidéo. Ce
      site rassemble mon parcours scolaire et mon CV ; la version imprimable est
      disponible en un clic.
    </p>

    <div class="mt-6">
      <Button text="Télécharger mon CV" link={`${base}cv.html`} />
    </div>

    <h2
      class="mt-12 mb-2 text-2xl font-bold lg:mt-16 dark:text-neutral-200"
    >
      Expérience
    </h2>
    <div class="mt-4 rounded-2xl border border-dashed border-accent/30 bg-accent-soft/60 p-5 dark:border-accent/30 dark:bg-accent-night">
      <h3 class="text-base font-semibold text-neutral-900 dark:text-neutral-100">
        Stage en programmation
      </h3>
      <p class="text-sm text-neutral-500 dark:text-neutral-400">Apptitude</p>
      <ul class="mt-2 list-disc space-y-1 pl-4 text-sm text-neutral-500 dark:text-neutral-400">
        <li>
          Développement d'une petite application pour mon usage personnel, en HTML.
        </li>
        <li>
          Conception de l'interface d'une application pour tester le design ; cette
          expérience m'a confirmé ma préférence pour le développement et la
          programmation.
        </li>
      </ul>
    </div>

    <p class="mt-4 text-sm text-neutral-500 dark:text-neutral-400">
      Stage recherché : <strong class="text-neutral-900 dark:text-neutral-100">3 mai — 4 juin 2027</strong>
    </p>

    <h2
      class="mt-12 mb-2 text-2xl font-bold lg:mt-16 dark:text-neutral-200"
    >
      Compétences
    </h2>
    <div class="mt-4 flex flex-wrap gap-2">
      {
        [
          "Curiosité",
          "Apprentissage continu",
          "Écoute active",
          "Communication",
          "Flexibilité",
          "Motivation",
          "Implication",
        ].map((competence) => (
          <span class="rounded-full border border-accent/25 bg-accent-soft px-3 py-1.5 text-sm text-accent dark:border-accent/30 dark:bg-accent-night dark:text-accent-light">
            {competence}
          </span>
        ))
      }
    </div>

    <h2
      class="mt-12 mb-2 text-2xl font-bold lg:mt-16 dark:text-neutral-200"
    >
      Parcours scolaire
    </h2>

    <div class="mt-6">
      <h3
        class="mb-4 text-xs font-semibold uppercase tracking-[0.2em] text-neutral-500 dark:text-neutral-400"
      >
        École secondaire
      </h3>
      <ul class="divide-y divide-neutral-200 dark:divide-neutral-800">
        {
          secondaire.map((etape) => (
            <li class="flex flex-col gap-1 py-3 sm:flex-row sm:items-baseline sm:justify-between">
              <span class="text-base font-medium text-neutral-900 dark:text-neutral-100">
                {etape.etablissement} · {etape.cycle}
              </span>
              <span class="text-sm text-neutral-500 dark:text-neutral-400">
                {etape.dates}
              </span>
            </li>
          ))
        }
      </ul>

      <h3
        class="mb-4 mt-10 text-xs font-semibold uppercase tracking-[0.2em] text-neutral-500 dark:text-neutral-400"
      >
        École primaire
      </h3>
      <ul class="divide-y divide-neutral-200 dark:divide-neutral-800">
        {
          primaire.map((etape) => (
            <li class="flex flex-col gap-1 py-3 sm:flex-row sm:items-baseline sm:justify-between">
              <span class="text-base font-medium text-neutral-900 dark:text-neutral-100">
                {etape.etablissement} · {etape.cycle}
              </span>
              <span class="text-sm text-neutral-500 dark:text-neutral-400">
                {etape.dates}
              </span>
            </li>
          ))
        }
      </ul>
    </div>

    <h2 class="mt-12 mb-2 text-2xl font-bold lg:mt-16 dark:text-neutral-200">
      Langues
    </h2>
    <ul class="mt-4 divide-y divide-neutral-200 dark:divide-neutral-800">
      {
        langues.map((langue) => (
          <li class="flex items-baseline justify-between gap-4 py-3">
            <span class="text-base font-medium text-neutral-900 dark:text-neutral-100">
              {langue.nom}
            </span>
            <span class="text-sm text-neutral-500 dark:text-neutral-400">
              {langue.niveau}
            </span>
          </li>
        ))
      }
    </ul>

    <h2 class="mt-12 mb-2 text-2xl font-bold lg:mt-16 dark:text-neutral-200">
      Centres d'intérêt
    </h2>
    <div class="mt-4 flex flex-wrap gap-2">
      {
        ["Lecture", "Dessin", "Jeux vidéo"].map((interet) => (
          <span class="rounded-full border border-accent/25 bg-accent-soft px-3 py-1.5 text-sm text-accent dark:border-accent/30 dark:bg-accent-night dark:text-accent-light">
            {interet}
          </span>
        ))
      }
    </div>

    <h2 class="mt-12 mb-2 text-2xl font-bold lg:mt-16 dark:text-neutral-200">
      Me contacter
    </h2>
    <p
      class="text-sm leading-6 text-gray-600 dark:text-neutral-400 sm:leading-7 lg:leading-8 sm:text-base lg:text-lg"
    >
      Vous pouvez m'écrire à <a
        href="mailto:maloe.decastel@gmail.com"
        class="text-accent underline dark:text-accent-light">maloe.decastel@gmail.com</a
      > ou m'appeler au <a href="tel:+41766178337" class="text-accent underline dark:text-accent-light"
        >+41 76 617 83 37</a
      >.
    </p>
  </section>
</Layout>
