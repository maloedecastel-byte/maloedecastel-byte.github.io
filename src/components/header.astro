---
import menus from "../collections/menu.json";
import Logo from "../components/logo.astro";

const base = import.meta.env.BASE_URL;
const menuHref = (url) => (url === "" ? base : `${base}${url}`);
---

<!-- This is an invisible div with relative position so that it takes up the height of the menu (because menu is absolute/fixed) -->
<div class="relative w-full h-20 opacity-0 pointer-events-none"></div>
<header id="header" class="absolute top-0 z-50 w-full h-20">
  <div
    class="flex items-center justify-between h-full max-w-5xl pl-6 pr-4 mx-auto border-b border-l-0 border-r-0 border-transparent select-none lg:border-r lg:border-l lg:rounded-b-xl"
  >
    <Logo />
    <div
      id="mobileMenuBackground"
      onclick="closeMobileMenu()"
      aria-hidden="true"
      class="fixed inset-0 z-20 hidden w-screen h-screen duration-300 ease-out bg-white/90 dark:bg-neutral-950/90"
    >
    </div>
    <nav
      aria-label="Navigation principale"
      class="relative z-30 flex flex-row-reverse justify-start w-full text-sm sm:justify-end text-neutral-500 dark:text-neutral-400 sm:flex-row"
    >
      <button
        id="openMenu"
        type="button"
        aria-label="Ouvrir le menu"
        aria-expanded="false"
        aria-controls="menu"
        class="flex items-center justify-center w-11 h-11 ml-2 text-neutral-600 duration-200 ease-out bg-transparent border border-transparent rounded-full cursor-pointer sm:hidden hover:border-neutral-200 hover:text-neutral-900 dark:text-neutral-300 dark:hover:border-neutral-700 dark:hover:text-white"
      >
        <svg
          aria-hidden="true"
          focusable="false"
          class="w-7 h-7"
          fill="none"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          viewBox="0 0 24 24"
          stroke="currentColor"><path d="M4 8h16M4 16h16"></path></svg
        >
      </button>
      <button
        id="closeMenu"
        type="button"
        aria-label="Fermer le menu"
        aria-controls="menu"
        class="flex items-center justify-center hidden w-11 h-11 ml-2 text-neutral-600 duration-200 ease-out bg-transparent border border-transparent rounded-full cursor-pointer sm:hidden hover:border-neutral-200 hover:text-neutral-900 dark:text-neutral-300 dark:hover:border-neutral-700 dark:hover:text-white"
      >
        <svg
          aria-hidden="true"
          focusable="false"
          class="w-6 h-6"
          fill="none"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          viewBox="0 0 24 24"
          stroke="currentColor"><path d="M6 18L18 6M6 6l12 12"></path></svg
        >
      </button>
      <div
        id="menu"
        class="fixed top-[75px] ease-out duration-300 sm:top-0 w-full left-0 sm:py-0 pt-7 pb-4 dm:mx-0 left-0 z-40 flex-col items-end justify-start hidden w-full h-auto text-sm sm:text-base sm:h-auto sm:relative sm:flex-row sm:flex sm:text-sm sm:w-auto sm:pr-0 sm:pt-0"
      >
        <div
          class="absolute inset-0 top-0 right-0 block w-full h-full px-3 sm:hidden"
          aria-hidden="true"
        >
          <div
            class="relative w-full h-full bg-white border border-dashed border-neutral-300 dark:border-neutral-700 backdrop-blur-sm rounded-xl dark:bg-neutral-950"
          >
          </div>
        </div>
        {
          menus.map((menu) => {
            return (
              <a
                href={menuHref(menu.url)}
                class="relative flex items-center justify-center w-full min-h-[44px] px-3 py-3 font-medium tracking-wide text-center duration-200 ease-out sm:min-h-0 sm:py-0 sm:mb-0 md:w-auto hover:text-neutral-900 dark:hover:text-white"
              >
                {menu.name}
              </a>
            )
          })
        }
      </div>
      <button
        id="darkToggle"
        type="button"
        aria-label="Activer le mode sombre"
        class="relative flex items-center justify-center w-11 min-w-[44px] min-h-[44px] py-2 pl-0 ml-2 font-medium tracking-wide bg-transparent border-0 rounded-full cursor-pointer sm:w-auto sm:justify-start sm:pl-6 text-neutral-800 group dark:text-white"
      >
        <span class="absolute left-1/2 flex items-center justify-center w-6 h-6 overflow-hidden -translate-x-1/2 border-b border-transparent horizon group-hover:border-neutral-600 sm:left-0 sm:translate-x-0">
          <svg
            aria-hidden="true"
            focusable="false"
            class="absolute w-6 h-6 transition duration-700 transform ease"
            id="sun"
            fill="none"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            viewBox="0 0 24 24"
            stroke="currentColor"
            ><path
              d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
            ></path></svg
          >
          <svg
            aria-hidden="true"
            focusable="false"
            class="absolute hidden w-6 h-6 transition duration-700 transform ease"
            id="moon"
            fill="none"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            viewBox="0 0 24 24"
            stroke="currentColor"
            ><path
              d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
            ></path></svg
          >
        </span>
        <span class="hidden sm:inline-block">
          <span id="dayText" class="ml-2">Mode clair</span>
          <span id="nightText" class="hidden ml-2">Mode sombre</span>
        </span>
      </button>
    </nav>
  </div>
</header>
