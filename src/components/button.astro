---
const { link, text } = Astro.props;
---

<a
  href={link}
  class="inline-flex w-auto px-4 py-2 mt-5 text-xs font-semibold duration-300 ease-out border rounded-full bg-accent text-white border-accent hover:bg-white hover:text-accent hover:border-accent dark:bg-accent-light dark:text-neutral-950 dark:border-accent-light dark:hover:bg-black dark:hover:text-accent-light dark:hover:border-accent-light"
>
  {text}
</a>
