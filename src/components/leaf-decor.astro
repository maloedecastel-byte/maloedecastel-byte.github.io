---
// Décor floral discret : une fleur au trait fin, une étincelle et quelques
// pointillés — inspiré des dessins de fleurs simples.
const { class: className = "" } = Astro.props;
// Identifiant unique : plusieurs fleurs peuvent cohabiter sur une même page.
const uid = Math.random().toString(36).slice(2, 8);
const petale = `petale-${uid}`;
---

<svg
  class={className}
  viewBox="0 0 160 130"
  fill="none"
  stroke="currentColor"
  stroke-width="1.4"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <!-- Un pétale, dessiné depuis le centre de la fleur (100, 62) -->
    <path id={petale} d="M100 62C88 46 87 27 100 13c13 14 12 33 0 49z" />
  </defs>

  <!-- Fleur : six pétales -->
  <use href={`#${petale}`} />
  <use href={`#${petale}`} transform="rotate(60 100 62)" />
  <use href={`#${petale}`} transform="rotate(120 100 62)" />
  <use href={`#${petale}`} transform="rotate(180 100 62)" />
  <use href={`#${petale}`} transform="rotate(240 100 62)" />
  <use href={`#${petale}`} transform="rotate(300 100 62)" />

  <!-- Nervures des pétales -->
  <g stroke-width=".9">
    <path d="M100 56V22" />
    <path d="M100 56V22" transform="rotate(60 100 62)" />
    <path d="M100 56V22" transform="rotate(120 100 62)" />
    <path d="M100 56V22" transform="rotate(180 100 62)" />
    <path d="M100 56V22" transform="rotate(240 100 62)" />
    <path d="M100 56V22" transform="rotate(300 100 62)" />
  </g>

  <!-- Cœur de la fleur -->
  <circle cx="100" cy="62" r="2.6" fill="currentColor" stroke="none" />

  <!-- Étamines -->
  <g stroke-width="1">
    <path d="M100 62l4-11" />
    <circle cx="104" cy="50" r="1.5" fill="currentColor" stroke="none" />
    <path d="M100 62l-9-8" />
    <circle cx="90" cy="53" r="1.5" fill="currentColor" stroke="none" />
    <path d="M100 62l-10 4" />
    <circle cx="89" cy="67" r="1.5" fill="currentColor" stroke="none" />
    <path d="M100 62l4 11" />
    <circle cx="105" cy="74" r="1.5" fill="currentColor" stroke="none" />
    <path d="M100 62l10-1" />
    <circle cx="111" cy="61" r="1.5" fill="currentColor" stroke="none" />
  </g>

  <!-- Étincelle et pointillés -->
  <path d="M30 26c.8-5 2-6.4 7-7-5-.6-6.2-2-7-7-.8 5-2 6.4-7 7 5 .6 6.2 2 7 7z" stroke-width="1.2" />
  <g fill="currentColor" stroke="none">
    <circle cx="30" cy="40" r="1.4" />
    <circle cx="30" cy="48" r="1.4" />
    <circle cx="30" cy="56" r="1.4" />
  </g>
</svg>
