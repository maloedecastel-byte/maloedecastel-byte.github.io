---
// Décor floral discret : quelques feuilles en trait fin, couleur d'accent.
const { class: className = "" } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 200 240"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  aria-hidden="true"
  focusable="false"
>
  <!-- Branche principale -->
  <path d="M100 236C100 190 96 140 104 92c5-30 14-56 26-78" />

  <!-- Feuilles gauche -->
  <path d="M101 196c-18-4-30-14-34-30 16-2 29 6 34 22z" />
  <path d="M99 160c-20-3-33-13-37-30 18-2 32 7 37 24z" />
  <path d="M101 124c-18-3-30-13-33-28 16-2 29 6 33 22z" />
  <path d="M107 88c-16-4-26-13-28-27 15-1 26 6 28 21z" />

  <!-- Feuilles droite -->
  <path d="M105 178c18-5 30-16 33-32-17-1-29 8-33 25z" />
  <path d="M107 141c18-5 29-16 32-31-17-1-28 8-32 24z" />
  <path d="M113 104c16-5 26-15 29-29-15-1-26 7-29 22z" />
  <path d="M122 70c14-5 22-14 24-26-13-1-22 6-24 20z" />

  <!-- Petite fleur au sommet -->
  <circle cx="132" cy="16" r="5" />
