---
const base = import.meta.env.BASE_URL;
---

<a
  href={base}
  class="h-5 min-h-[44px] py-2 text-base group relative z-30 flex items-center space-x-1.5 whitespace-nowrap text-black dark:text-white font-semibold"
>
  <span
    aria-hidden="true"
    class="text-xl -translate-y-0.5 text-accent group-hover:-rotate-12 group-hover:scale-[1.2] ease-in-out duration-300 dark:text-accent-light"
    >✦</span
  >
  <!-- Logo Text -->
  <span class="-translate-y-0.5"> Maloe Decastel</span>
</a>
